# CircleBites E2E configuration
#
# Copy this file to .env.e2e and fill in dedicated test credentials.
# playwright.config.ts automatically loads .env.e2e.
#
# Required in .env.local before running the app/E2E suite:
# NEXT_PUBLIC_SUPABASE_URL=...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
#
# Test user model expected by the E2E suite:
# - User A: public account, owns seeded public + circle-only reviews.
# - User B: public account, mutual circle member with User A.
# - User C: private account, outsider to A/B for privacy and request flows.
#
# The seed script creates/updates these users in Supabase Auth, upserts
# matching profiles, seeds E2E Kitchen reviews, and creates the A <-> B circle.

E2E_USER_A_EMAIL=circlebites.e2e.alice@example.com
E2E_USER_A_PASSWORD=replace-with-strong-password
E2E_USER_A_NAME=E2E Alice

E2E_USER_B_EMAIL=circlebites.e2e.bob@example.com
E2E_USER_B_PASSWORD=replace-with-strong-password
E2E_USER_B_NAME=E2E Bob

E2E_USER_C_EMAIL=circlebites.e2e.carol@example.com
E2E_USER_C_PASSWORD=replace-with-strong-password
E2E_USER_C_NAME=E2E Carol

# Optional: point Playwright at an already-running app instead of starting npm run dev.
# E2E_PORT=3100
# E2E_BASE_URL=http://127.0.0.1:3100
#
# Optional: run browser smoke tests against a deployed app.
# Use only after seeding the same Supabase project used by that deployment.
# E2E_BASE_URL=https://your-production-domain.com

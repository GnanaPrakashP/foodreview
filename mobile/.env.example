EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.5:3000
EXPO_PUBLIC_WEB_BASE_URL=https://www.circlebites.in
EXPO_PUBLIC_CANONICAL_EXPLORE=1
EXPO_PUBLIC_APP_ENVIRONMENT=local
# Release-profile experiments only. Requires EXPO_PUBLIC_PERFORMANCE_PROFILE=1
# and is forbidden in the production environment.
# EXPO_PUBLIC_MEMORY_ROOM_CHAT_LIFECYCLE=cold
# EXPO_PUBLIC_MEMORY_ROOM_CHAT_RENDERER=vendor # or native-recycler for Stage-1 Android profiling
# Setting BOTH of the following selects the retained-host + recycled-rows
# prototype: the native host stays mounted across tab switches, so its cell
# pool survives and entering Chat resumes instead of rebuilding. The first
# entry is warmed during the room's idle window, so watch
# MemoryRoomNativeChatCreatedCellsThisActivation — it should read 0 from the
# FIRST Chat entry onward. Room open/exit are part of its acceptance too: the
# warm moves a layout and one viewport of cells into room open.
# EXPO_PUBLIC_MEMORY_ROOM_CHAT_LIFECYCLE=warm-bounded
# EXPO_PUBLIC_MEMORY_ROOM_CHAT_RENDERER=native-recycler
EXPO_PUBLIC_RELEASE_CHANNEL=local
EXPO_PUBLIC_RELEASE_ID=local
EXPO_PUBLIC_HOME_LIST_ENGINE=flatlist
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# EAS/Sentry source-map upload values are build-only and must not use an
# EXPO_PUBLIC prefix: SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT.

# Production uses circlebites; preview uses circlebites-preview; development
# uses circlebites-dev. Supabase Auth must allow only the two callback paths for
# the matching environment. Do not add
# provider keys, service-role keys, worker secrets, limiter secrets, or cleanup
# secrets to Expo public configuration.

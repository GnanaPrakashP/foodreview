EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.5:3000
EXPO_PUBLIC_CANONICAL_EXPLORE=1
EXPO_PUBLIC_APP_ENVIRONMENT=local
EXPO_PUBLIC_RELEASE_ID=local
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# EAS/Sentry source-map upload values are build-only and must not use an
# EXPO_PUBLIC prefix: SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT.

# The app scheme is fixed in app.json as circlebites. Supabase Auth must allow
# circlebites://auth/callback** and circlebites://auth/recovery**. Do not add
# provider keys, service-role keys, worker secrets, limiter secrets, or cleanup
# secrets to Expo public configuration.

# Dev-only auto-login (emulator/Expo Go). When set and running in __DEV__,
# the app signs in automatically on cold start if there is no saved session.
# Leave blank in any shared/production env.
EXPO_PUBLIC_DEV_AUTOLOGIN_EMAIL=
EXPO_PUBLIC_DEV_AUTOLOGIN_PASSWORD=

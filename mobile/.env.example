EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.5:3000

# Dev-only auto-login (emulator/Expo Go). When set and running in __DEV__,
# the app signs in automatically on cold start if there is no saved session.
# Leave blank in any shared/production env.
EXPO_PUBLIC_DEV_AUTOLOGIN_EMAIL=
EXPO_PUBLIC_DEV_AUTOLOGIN_PASSWORD=

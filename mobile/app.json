{
  "expo": {
    "name": "CircleBites",
    "slug": "circlebites-mobile",
    "scheme": "circlebites",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.circlebites.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "CircleBites uses the camera to capture food photos and short food videos for posts.",
        "NSMicrophoneUsageDescription": "CircleBites uses the microphone to record sound with food videos.",
        "NSPhotoLibraryUsageDescription": "CircleBites uses your photo library so you can add food photos and videos to posts.",
        "NSContactsUsageDescription": "CircleBites uses contacts only when you choose people to invite to a table memory.",
        "NSLocationWhenInUseUsageDescription": "CircleBites uses your location to show nearby restaurants and dishes.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.circlebites.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_CONTACTS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-secure-store",
      "expo-image-picker",
      "expo-contacts",
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-web-browser",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "920bf9e9-fe27-4c98-a35a-0d860d3e0402"
      }
    },
    "owner": "gnanaprakashps-team"
  }
}

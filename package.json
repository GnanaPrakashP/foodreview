{
  "name": "foodreview",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "dev:e2e": "next dev",
    "build": "next build --turbopack",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:memory-hardening": "node --test tests/shared-memory-phase1-security.test.mjs tests/shared-memory-phase2-media-security.test.mjs tests/shared-memory-phase3-scalability.test.mjs tests/shared-memory-phase4-mobile-performance.test.mjs tests/shared-memory-phase5-operations.test.mjs tests/shared-memory-phase6-ci.test.mjs",
    "verify:memory-hardening": "npm run test:memory-hardening && npm test && npm run test:coverage && npm run lint && npm run typecheck && npm run build && cd mobile && npm run typecheck",
    "test:coverage": "node --require ./tests/coverage-setup.cjs --test --experimental-test-coverage tests/*.test.mjs",
    "test:coverage:html": "npm run test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "validate:hardening-register": "node scripts/validate-production-hardening-issues.mjs",
    "media:worker": "node scripts/media-worker.mjs",
    "media:process-once": "MEDIA_WORKER_ONCE=1 node scripts/media-worker.mjs",
    "dish:backfill-mentions": "node scripts/backfill-review-dish-mentions.mjs",
    "dish:backfill-mapped-profiles": "node scripts/backfill-mapped-profile-dish-mentions.mjs",
    "dish:identity-report": "node scripts/dish-identity-report.mjs",
    "dish:missing-profile-map": "node scripts/dish-missing-profile-map.mjs",
    "dish:image-backfill": "node scripts/backfill-canonical-dish-images.mjs",
    "dish:place-id-repair-report": "node scripts/dish-place-id-repair-report.mjs",
    "dish:repair-place-ids": "node scripts/repair-review-dish-mention-place-ids.mjs",
    "dish:reresolve-candidates": "node scripts/reresolve-dish-candidates.mjs",
    "dish:self-curate": "node scripts/run-dish-self-curation.mjs",
    "explore:compare-canonical": "node scripts/compare-canonical-explore.mjs",
    "validate:android-profile": "node scripts/android-profile-login.mjs",
    "validate:android-profile:installed": "node scripts/android-installed-profile-login.mjs --restart-server",
    "validate:ios-profile": "node scripts/ios-profile-login.mjs",
    "mobile:reinstall:phone": "npm --prefix mobile run android:reinstall:phone --",
    "start": "next start"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "autoprefixer": "^10.5.0",
    "fuse.js": "^7.3.0",
    "lucide-react": "^1.14.0",
    "next": "15.5.15",
    "postcss": "^8.5.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "c8": "^10.1.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.15",
    "typescript": "^5"
  }
}
